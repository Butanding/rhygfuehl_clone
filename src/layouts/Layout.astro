---
import { pwaInfo } from 'virtual:pwa-info';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import de from '../locales/de.json';
import en from '../locales/en.json';
import { withBase, isClone } from '../utils/base';
import '../assets/index.css';

interface Props {
	title: string;
	description: string;
	lang: string;
}

const { title, description, lang } = Astro.props;
const t = lang === 'de' ? de : en;

const canonicalURL = new URL(Astro.url.pathname, 'https://rhygfuehl.ch');
const socialImageURL = new URL('/apple-touch-icon.png', 'https://rhygfuehl.ch');

const datasetSchema = {
	"@context": "https://schema.org",
	"@type": "Dataset",
	"name": lang === 'de' ? "Rheindaten Basel Aggregation" : "Rhine Data Basel Aggregation",
	"description": lang === 'de' 
		? "Aggregierte Umweltdaten des Rheins in Basel, einschliesslich Wassertemperatur, Globalstrahlung und Niederschlag zur Einschätzung der Badequalität."
		: "Aggregated environmental data of the Rhine in Basel, including water temperature, global radiation, and precipitation for assessing swimming quality.",
	"url": "https://rhygfuehl.ch",
	"license": "https://creativecommons.org/licenses/by/4.0/",
	"isBasedOn": "https://data.bs.ch/",
	"creator": {
		"@type": "Organization",
		"name": "rhygfuehl.ch"
	},
	"variableMeasured": [
		{
			"@type": "PropertyValue",
			"name": lang === 'de' ? "Wassertemperatur" : "Water Temperature",
			"unitText": "°C"
		},
		{
			"@type": "PropertyValue",
			"name": lang === 'de' ? "Globalstrahlung" : "Global Radiation",
			"unitText": "W/m²"
		},
		{
			"@type": "PropertyValue",
			"name": lang === 'de' ? "Niederschlag" : "Precipitation",
			"unitText": "mm"
		}
	],
	"citation": "https://www.kantonslabor.bs.ch/umwelt/badewasser/rhein.html"
};
---

<!doctype html>
<html lang={lang} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<!-- Experiment mode (shows the BETA tiles): read before the first paint so nothing flashes.
		     ?experiment=on / ?experiment=off sets it, the choice is kept in localStorage. -->
		<script is:inline>
			(function () {
				var on = false;
				try {
					var param = new URLSearchParams(location.search).get('experiment');
					if (param === 'on' || param === 'off') localStorage.setItem('experiment', param);
					on = localStorage.getItem('experiment') === 'on';
				} catch (e) {}
				document.documentElement.setAttribute('data-experiment', on ? 'on' : 'off');
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		{isClone && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalURL} />

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_GB'} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={socialImageURL} />
		
		<!-- PWA Meta Tags -->
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#002855" media="(prefers-color-scheme: dark)" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="rhygfuehl" />
		<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
		{pwaInfo && <link rel="manifest" href={pwaInfo.webManifest.href} />}

		<!-- Umami Cloud Tracking -->
		{!isClone && <script defer src="https://cloud.umami.is/script.js" data-website-id="209370c3-c631-4cef-80f2-6fe9a59e45e4"></script>}


	</head>
	<body class="min-h-screen bg-white dark:bg-darkblue text-darkblue dark:text-white transition-colors duration-300 antialiased">
		<header class="max-w-screen-md mx-auto px-5 pt-8 flex items-center justify-between">
			<h1 class="text-2xl font-bold">
				<a href={withBase(lang === 'de' ? '/' : '/en/')}>rhygfuehl</a>
			</h1>
			<nav class="flex flex-wrap items-center justify-end gap-1.5">
				<div
					class="flex bg-darkblue/5 dark:bg-white/5 p-1 rounded-full border border-darkblue/10 dark:border-white/10"
					role="group"
					aria-label={t.experimentMode}
				>
					<button type="button" class="experiment-option px-2.5 py-1.5 text-xs font-bold rounded-full transition-all duration-300" data-experiment-option="off" aria-pressed="true">
						{t.experimentOff}
					</button>
					<button type="button" class="experiment-option px-2.5 py-1.5 text-xs font-bold rounded-full transition-all duration-300" data-experiment-option="on" aria-pressed="false">
						{t.experimentOn}
					</button>
				</div>
				<div class="flex bg-darkblue/5 dark:bg-white/5 p-1 rounded-full border border-darkblue/10 dark:border-white/10">
					<a 
						href={withBase('/')}
						class={`px-4 py-1.5 text-xs font-bold rounded-full transition-all duration-300 ${lang === 'de' ? 'bg-white dark:bg-darkblue text-darkblue dark:text-white shadow-sm' : 'opacity-40 hover:opacity-100'}`}
					>
						DE
					</a>
					<a 
						href={withBase('/en/')}
						class={`px-4 py-1.5 text-xs font-bold rounded-full transition-all duration-300 ${lang === 'en' ? 'bg-white dark:bg-darkblue text-darkblue dark:text-white shadow-sm' : 'opacity-40 hover:opacity-100'}`}
					>
						EN
					</a>
				</div>
			</nav>
		</header>
		<main class="max-w-screen-md mx-auto px-5 py-8">
			<slot />
		</main>
		<Footer t={t} lang={lang} />

		<!-- PWA automatic updates enabled -->

		<style is:global>
			@font-face {
				font-family: 'TikTok Sans';
				src: url('/fonts/tiktok-sans.ttf') format('truetype');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}
			body {
				font-family: 'TikTok Sans', sans-serif;
			}
			/* Experiment mode: BETA tiles are only shown when it is on (default: off) */
			.experiment-only { display: none; }
			html[data-experiment="on"] .experiment-only { display: block; }
			/* the switch looks like the language switch: the active side is raised */
			.experiment-option { opacity: 0.4; }
			.experiment-option:hover { opacity: 1; }
			html[data-experiment="off"] .experiment-option[data-experiment-option="off"],
			html[data-experiment="on"] .experiment-option[data-experiment-option="on"] {
				opacity: 1;
				background: #ffffff;
				color: #002855;
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
			}
			@media (prefers-color-scheme: dark) {
				html[data-experiment="off"] .experiment-option[data-experiment-option="off"],
				html[data-experiment="on"] .experiment-option[data-experiment-option="on"] {
					background: #002855;
					color: #ffffff;
				}
			}
			.collapse-grid {
				display: grid;
				grid-template-rows: 0fr;
				transition: grid-template-rows 0.3s ease-out;
			}
			.collapse-grid.is-open {
				grid-template-rows: 1fr;
			}
			.collapse-inner {
				overflow: hidden;
			}
		</style>
		
		<script>
			import { registerSW } from 'virtual:pwa-register';
			registerSW({ immediate: true });
		</script>

		<script>
			import { getMcpManifest } from '../utils/mcp';

			const htmlLang = (document.documentElement.lang as 'de' | 'en') || 'de';
			const manifest = getMcpManifest(htmlLang);

			// Resolve the WebMCP API surface (Chrome 150+ uses document.modelContext)
			const modelContext = (document as any).modelContext ?? (navigator as any).modelContext;

			if (modelContext?.registerTool) {
				manifest.tools.forEach((tool) => {
					try {
						modelContext.registerTool({
							name: tool.name,
							description: tool.description,
							inputSchema: tool.inputSchema,
							execute: tool.execute
						});
					} catch (error) {
						console.warn(`[WebMCP] Failed to register tool "${tool.name}":`, error);
					}
				});
			}

			// Expose global manifest for DevTools / Model Context Inspector
			(window as any).__webmcp = manifest;
			(window as any).__webmcp_tools = manifest.tools;
		</script>

		<script is:inline>
			// Experiment mode switch
			document.addEventListener('DOMContentLoaded', () => {
				const options = document.querySelectorAll('.experiment-option');
				const sync = () => {
					const on = document.documentElement.getAttribute('data-experiment') === 'on';
					options.forEach(o => o.setAttribute('aria-pressed', String((o.getAttribute('data-experiment-option') === 'on') === on)));
				};
				sync();
				options.forEach(option => {
					option.addEventListener('click', () => {
						const value = option.getAttribute('data-experiment-option');
						document.documentElement.setAttribute('data-experiment', value);
						try { localStorage.setItem('experiment', value); } catch (e) {}
						sync();
						// charts of a tile that was hidden need a new size
						window.dispatchEvent(new Event('resize'));
					});
				});
			});
		</script>

		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const toggles = document.querySelectorAll('.metric-toggle');
				
				toggles.forEach(toggle => {
					toggle.addEventListener('click', () => {
						const currentContent = toggle.nextElementSibling;
						const currentIcon = toggle.querySelector('.toggle-icon');
						const isOpen = currentContent.classList.contains('is-open');
						
						// Close all other cards
						if (!isOpen) {
							document.querySelectorAll('.collapse-grid.is-open').forEach(openContent => {
								if (openContent !== currentContent) {
									openContent.classList.remove('is-open');
									// Find the associated icon and reset it
									const otherToggle = openContent.previousElementSibling;
									const otherIcon = otherToggle.querySelector('.toggle-icon');
									if (otherIcon) otherIcon.classList.remove('rotate-180');
								}
							});
						}

						// Toggle current card
						if (isOpen) {
							currentContent.classList.remove('is-open');
							currentIcon.classList.remove('rotate-180');
						} else {
							currentContent.classList.add('is-open');
							currentIcon.classList.add('rotate-180');
						}
					});
				});
			});
		</script>
	</body>
</html>
